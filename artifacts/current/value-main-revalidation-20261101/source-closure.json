      "locators": [
        {
          "physical_page_1based": 54,
          "printed_page": 54,
          "article_locator": null,
          "needle": "公司法定公积金累计额为公司注册资本的50%以上的，可以不再提取。",
          "needle_matching": "REMOVE_UNICODE_WHITESPACE_ONLY",
          "cold_locator_verification": "MATCH_REMOVE_UNICODE_WHITESPACE_ONLY"
        },
        {
          "physical_page_1based": 55,
          "printed_page": 55,
          "article_locator": null,
          "needle": "公司利润分配不得超过累计可供分配利润的范围，不得损害公司持续经营能力。",
          "needle_matching": "REMOVE_UNICODE_WHITESPACE_ONLY",
          "cold_locator_verification": "MATCH_REMOVE_UNICODE_WHITESPACE_ONLY"
        },
        {
          "physical_page_1based": 56,
          "printed_page": 56,
          "article_locator": null,
          "needle": "公司应当调整利润分配政策",
          "needle_matching": "REMOVE_UNICODE_WHITESPACE_ONLY",
          "cold_locator_verification": "MATCH_REMOVE_UNICODE_WHITESPACE_ONLY"
        }
      ]
