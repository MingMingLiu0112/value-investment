      "locators": [
        {
          "physical_page_1based": null,
          "printed_page": null,
          "article_locator": "第二百一十条",
          "needle": "第二百一十条　公司分配当年税后利润时，应当提取利润的百分之十列入公司法定公积金。",
          "needle_matching": "REMOVE_UNICODE_WHITESPACE_ONLY",
          "cold_locator_verification": "MATCH_REMOVE_UNICODE_WHITESPACE_ONLY"
        },
        {
          "physical_page_1based": null,
          "printed_page": null,
          "article_locator": "第二百一十一条",
          "needle": "第二百一十一条　公司违反本法规定向股东分配利润的，股东应当将违反规定分配的利润退还公司；",
          "needle_matching": "REMOVE_UNICODE_WHITESPACE_ONLY",
          "cold_locator_verification": "MATCH_REMOVE_UNICODE_WHITESPACE_ONLY"
        },
        {
          "physical_page_1based": null,
          "printed_page": null,
          "article_locator": "第二百一十二条",
          "needle": "第二百一十二条　股东会作出分配利润的决议的，董事会应当在股东会决议作出之日起六个月内进行分配。",
          "needle_matching": "REMOVE_UNICODE_WHITESPACE_ONLY",
          "cold_locator_verification": "MATCH_REMOVE_UNICODE_WHITESPACE_ONLY"
        },
        {
          "physical_page_1based": null,
          "printed_page": null,
          "article_locator": "第二百一十四条",
          "needle": "第二百一十四条　公司的公积金用于弥补公司的亏损、扩大公司生产经营或者转为增加公司注册资本。",
          "needle_matching": "REMOVE_UNICODE_WHITESPACE_ONLY",
          "cold_locator_verification": "MATCH_REMOVE_UNICODE_WHITESPACE_ONLY"
        }
      ]
    },
