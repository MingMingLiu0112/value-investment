  "human_review_groups": [
    {"id": "EARNINGS", "question": "历史盈利代理是否足以用于低置信条件研究？", "support": "扣非TTM 813.6706767744亿元，原财报及归母口径桥已绑定。", "countercase": "正常化调整、金融尾部损失和维护投入上界未知，不能填零。", "impact": "保留代理只允许条件估值；若否定代理，现有逐年盈利路径需要重审，不能机械加回减损。", "field_paths": ["facts.operating_inputs", "research_case.financial_summary"]},
    {"id": "DURATION", "question": "B的优势持续期和衰减机制是否合理？", "support": "核心产品毛利与品牌渠道支持研究存量盈利持续性；A衰减速度尚无中性依据。", "countercase": "扣非和毛利走弱；十年不是可观测寿命，后五年仍为全资本ROE衰减。", "impact": "选A缩短条件持续期，选C延长尾部；具体逐年值与A/B/C输出见提案，不以市场价选择。", "field_paths": ["facts.scenario_inputs", "assumption_bindings"]},
    {"id": "DISTRIBUTION", "question": "留存、必要投入和股东分配的条件用途是否可接受？", "support": "共享模型逐年递推账面权益、留存和分配，未重复加入现金。", "countercase": "母公司可用现金、上划和认缴时点不由合并利润证明；维护与扩产未拆分。", "impact": "75%分配是模型条件，不是可得现金批准；资金限制重大时须重审分配或暂停模型。", "field_paths": ["facts.scenario_inputs", "source_contract.distribution_input_status"]},
    {"id": "COST_TERMINAL", "question": "权益成本和终端条件是否可用于该版本？", "support": "复用已绑定国债、beta、ERP研究和共享模型；中央成本约6.7572%。", "countercase": "成本代理异步，端点非完整风险区间；终端ROE等于成本不意味着资本损失风险消失。", "impact": "成本影响折现与衰减；2%增长在零终端剩余收益下抵消但影响自筹分配。复用已有敏感性，不调参制造买点。", "field_paths": ["facts.scenario_inputs", "facts.valuation_timing"]},
    {"id": "EVENT_MODEL", "question": "事件材料性和精确模型版本能否进入正式审查？", "support": "候选包、实际共享输出、Facts/Assumptions及模型上下文均精确绑定。", "countercase": "新候选没有继承公告批准、完整扫描或G3；生成日不是当前事件准入。", "impact": "逐项VERIFIED/REJECTED/INSUFFICIENT后依现有合同重算有效性和价格桥；当前仍NO_ACTION。", "field_paths": ["model_validity_input", "source_contract", "dependencies.model_version"]}
