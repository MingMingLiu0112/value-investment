n.pdf\",\"published_date\":\"2025-05-30\",\"sha256\":\"94999a4f3f922ab372895488f872b8be864e1f3d5f8c9c78e34d3c3dc6ae0b3f\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2025-05-30/1223718270.PDF\"},\"source_id\":\"cninfo:1223718270\",\"statement_scope\":\"listed_parent_external_shareholders_gross_tax\",\"unit\":\"CNY\",\"verification\":\"ORIGINAL_LABEL_ORDERED_CURRENT_AND_COMPARATIVE_COLUMNS_MATCH\"},{\"columns\":[{\"period\":\"H12026\",\"value\":\"-5692824600.30\"}],\"currency\":\"CNY\",\"evidence_excerpt\":\"对所有者（或股东）的分配-5,692,824,600.30\",\"id\":\"h1_parent_equity_distribution\",\"label\":\"对所有者（或股东）的分配\",\"physical_page\":62,\"source_binding\":{\"availability_basis\":\"date_only_next_day_bound_not_intraday_timestamp\",\"available_at_conservative\":\"2026-08-28T00:00:00+08:00\",\"current_local_verified_at\":\"2026-10-11T03:00:50.263465+00:00\",\"id\":\"cninfo:1225511409\",\"original_retrieved_at\":null,\"parser_version\":\"existing_infrastructure.filings.pdf_text/PDFium\",\"path\":\"D:/GPTProject/value-investment/runtime/company-research/m1-valuation-filings-20260923/600887/2026-06-30-interim-6c456d8e5f19ba114b2cac48595f997612f66b337d294265975ed5eb7c3499ab.pdf\",\"published_date\":\"2026-08-27\",\"sha256\":\"423af4d63f2b620a03ed9d0080adbb063f3ef14d874abeca8097d0e0d1441ac2\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-08-27/1225511409.PDF\"},\"source_id\":\"cninfo:1225511409\",\"statement_scope\":\"listed_parent_only\",\"unit\":\"CNY\",\"verification\":\"ORIGINAL_LABEL_ORDERED_CURRENT_AND_COMPARATIVE_COLUMNS_MATCH\"},{\"columns\":[{\"period\":\"SCP010_paid_2026-09-29\",\"value\":\"10031454794.52\"},{\"period\":\"SCP011_paid_2026-09-29\",\"value\":\"10031454794.52\"}],\"currency\":\"CNY\",\"evidence_excerpt\":\"本息兑付总额分别为人民币10,031,454,794.52元、10,031,454,794.52\",\"id\":\"settlement_two_issue_amounts\",\"label\":\"本息兑付总额分别为人民币\",\"physical_page\":1,\"source_binding\":{\"availability_basis\":\"date_only_next_day_bound_not_intraday_timestamp\",\"available_at_conservative\":\"2026-10-02T00:00:00+08:00\",\"current_local_verified_at\":\"2026-10-11T03:00:50.263465+00:00\",\"id\":\"cninfo:1225591152\",\"original_retrieved_at\":null,\"parser_version\":\"existing_infrastructure.filings.pdf_text/PDFium\",\"path\":\"D:/GPTProject/value-investment/runtime/public-event-followup-20261002/1225591152.pdf\",\"published_date\":\"2026-10-01\",\"sha256\":\"f59267675689f0d77cc142d91e910e2e839adfc0282a260483e0858cc82a1ba3\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-10-01/1225591152.PDF\"},\"source_id\":\"cninfo:1225591152\",\"statement_scope\":\"issuer_disclosed_completed_not_bank_statement\",\"unit\":\"CNY\",\"verification\":\"ORIGINAL_LABEL_ORDERED_CURRENT_AND_COMPARATIVE_COLUMNS_MATCH\"}],\"financial_period_end\":\"2026-06-30\",\"generated_at\":\"2026-10-11T03:00:50.263465+00:00\",\"generated_at_role\":\"ARTIFACT_GENERATION_NOT_RESEARCH_CUTOFF\",\"limitations\":[\"历史扣非不是正常化盈利；商誉/存货减值及税费不直接按税前数加回归母利润。\",\"母公司与合并CFO差异可观察，具体内部结算/融资及现金可取性贡献未建立归属桥。\",\"货币资金与现金等价物差额不全部解释为受限现金；资产负债表现金不净掉外部银行义务。\",\"实施公告与权益减少支持披露层已执行股息，未获得逐笔银行到账凭证；普通/特别分类未知。\",\"75%/1.22元政策已获股东会通过，不是未来可分配现金证明。\",\"6/30余额不能减9/29兑付金额推算期末现金；资金来源和兑付后债务/现金仍未知。\",\"原件可用日与今天核验时点分开；不证明完整事件覆盖或历史同期运行。\",\"未消费旧8%盈利增长/ROE路径，未产生新估值、报价、模型审批或仓位。\"],\"manifest_binding\":{\"path\":\"runtime/d2-real-admission-20261011/600887-current-facts-v1/manifest.json\",\"sha256\":\"1f1207e343cbc08dead636f2ba61ce76012b290a19776f4c0d9ef20a0acca384\"},\"model_approved\":false,\"price_admitted\":false,\"scope\":\"NOT_ADMITTED\",\"source_bindings\":[{\"availability_basis\":\"date_only_next_day_bound_not_intraday_timestamp\",\"available_at_conservative\":\"2026-05-01T00:00:00+08:00\",\"current_local_verified_at\":\"2026-10-11T03:00:50.263465+00:00\",\"id\":\"cninfo:1225259562\",\"original_retrieved_at\":null,\"parser_version\":\"existing_infrastructure.filings.pdf_text/PDFium\",\"path\":\"D:/GPTProject/value-investment/runtime/company-research/m1-valuation-filings-20260923/600887/2025-12-31-annual-ef988688acf64ebeafd5ad3da4721c9f3390ae9c204038cd4e1e3ae3b5ec8451.pdf\",\"published_date\":\"2026-04-30\",\"sha256\":\"d17b8c541c42f65d092317093eb0cfbb5aeed4f44eafa2d2f6182041cdcdbaac\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-04-30/1225259562.PDF\"},{\"availability_basis\":\"date_only_next_day_bound_not_intraday_timestamp\",\"available_at_conservative\":\"2026-08-28T00:00:00+08:00\",\"current_local_verified_at\":\"2026-10-11T03:00:50.263465+00:00\",\"id\":\"cninfo:1225511409\",\"original_retrieved_at\":null,\"parser_version\":\"existing_infrastructure.filings.pdf_text/PDFium\",\"path\":\"D:/GPTProject/value-investment/runtime/company-research/m1-valuation-filings-20260923/600887/2026-06-30-interim-6c456d8e5f19ba114b2cac48595f997612f66b337d294265975ed5eb7c3499ab.pdf\",\"published_date\":\"2026-08-27\",\"sha256\":\"423af4d63f2b620a03ed9d0080adbb063f3ef14d874abeca8097d0e0d1441ac2\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-08-27/1225511409.PDF\"},{\"availability_basis\":\"date_only_next_day_bound_not_intraday_timestamp\",\"available_at_conservative\":\"2026-05-30T00:00:00+08:00\",\"current_local_verified_at\":\"2026-10-11T03:00:50.263465+00:00\",\"id\":\"cninfo:1225335436\",\"original_retrieved_at\":null,\"parser_version\":\"existing_infrastructure.filings.pdf_text/PDFium\",\"path\":\"D:/GPTProject/value-investment/runtime/company-research/m1-dividend-followup-20260928/600887/yili-fy2025-final-dividend-implementation.pdf\",\"published_date\":\"2026-05-29\",\"sha256\":\"c8cd69e0a195ec9daa702306a2ba1ebf7cb8b53b1f5cae5d872cd590b0ba3c70\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-05-29/1225335436.PDF\"},{\"availability_basis\":\"date_only_next_day_bound_not_intraday_timestamp\",\"available_at_conservative\":\"2025-12-10T00:00:00+08:00\",\"current_local_verified_at\":\"2026-10-11T03:00:50.263465+00:00\",\"id\":\"cninfo:1224859455\",\"original_retrieved_at\":null,\"parser_version\":\"existing_infrastructure.filings.pdf_text/PDFium\",\"path\":\"D:/GPTProject/value-investment/runtime/company-research/m1-dividend-lifecycles/20260923T052056Z/600887/yili_fy2025_interim_implementation.pdf\",\"published_date\":\"2025-12-09\",\"sha256\":\"cb0f2870dd2ed48799ec5c3403c402dc09129270b030b533818ba7b9662f0322\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2025-12-09/1224859455.PDF\"},{\"availability_basis\":\"date_only_next_day_bound_not_intraday_timestamp\",\"available_at_conservative\":\"2025-05-31T00:00:00+08:00\",\"current_local_verified_at\":\"2026-10-11T03:00:50.263465+00:00\",\"id\":\"cninfo:1223718270\",\"original_retrieved_at\":null,\"parser_version\":\"existing_infrastructure.filings.pdf_text/PDFium\",\"path\":\"D:/GPTProject/value-investment/runtime/company-research/m1-dividend-lifecycles/20260923T052056Z/600887/yili_fy2024_final_implementation.pdf\",\"published_date\":\"2025-05-30\",\"sha256\":\"94999a4f3f922ab372895488f872b8be864e1f3d5f8c9c78e34d3c3dc6ae0b3f\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2025-05-30/1223718270.PDF\"},{\"availability_basis\":\"date_only_next_day_bound_not_intraday_timestamp\",\"available_at_conservative\":\"2026-05-22T00:00:00+08:00\",\"current_local_verified_at\":\"2026-10-11T03:00:50.263465+00:00\",\"id\":\"cninfo:1225321219\",\"original_retrieved_at\":null,\"parser_version\":\"existing_infrastructure.filings.pdf_text/PDFium\",\"path\":\"D:/GPTProject/value-investment/runtime/company-research/yili-dividend-approval-202605/1225321219.pdf\",\"published_date\":\"2026-05-21\",\"sha256\":\"bda5690cbb6f81b591c7b731f9091d157071abed3054269000b8c690d68a8934\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-05-21/1225321219.PDF\"},{\"availability_basis\":\"date_only_next_day_bound_not_intraday_timestamp\",\"available_at_conservative\":\"2026-10-02T00:00:00+08:00\",\"current_local_verified_at\":\"2026-10-11T03:00:50.263465+00:00\",\"id\":\"cninfo:1225591152\",\"original_retrieved_at\":null,\"parser_version\":\"existing_infrastructure.filings.pdf_text/PDFium\",\"path\":\"D:/GPTProject/value-investment/runtime/public-event-followup-20261002/1225591152.pdf\",\"published_date\":\"2026-10-01\",\"sha256\":\"f59267675689f0d77cc142d91e910e2e839adfc0282a260483e0858cc82a1ba3\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-10-01/1225591152.PDF\"}],\"status\":\"SOURCE_VERIFIED_RESEARCH_SUPPLEMENT_NOT_ADMITTED\",\"strict_pit_admitted\":false,\"symbol\":\"600887\",\"verification_scope\":\"LOCAL_SOURCE_BYTES_ONLY_NOT_FINANCIAL_APPROVAL\"},\"weighted_roe_2025\":\"0.2087\"},\"generated_at\":\"2026-10-21T16:39:10.949988+00:00\",\"industry\":\"食品饮料-乳制品\",\"investment_path\":\"成熟优质复利 / 现金回报\",\"mispricing_hypothesis\":\"未证明市场系统性低估。当前只检验有条件权益价值区间能否容纳市价，不把当前价当作买入信号。\",\"missing_date_reasons\":{\"quote_date\":\"New pending model has no admitted quote.\"},\"name\":\"伊利股份\",\"next_events\":[{\"evidence_refs\":[\"yili_2026h1\"],\"kind\":\"fact\",\"text\":\"观察下一份法定财务报告的收入、分产品毛利率、经营现金流、合同负债、应收和短期借款。\"},{\"kind\":\"gap\",\"text\":\"补充普通股分母、可分配现金和回购/分红执行情况后再做正式人工批准。\"}],\"positives\":[{\"evidence_refs\":[\"yili_fy2025_annual\"],\"kind\":\"fact\",\"text\":\"FY2025 审计报告为无保留意见，归母净利润 115.65 亿元，加权平均 ROE 20.87%。\"},{\"evidence_refs\":[\"yili_fy2025_annual\"],\"kind\":\"fact\",\"text\":\"FY2025 末期每 10 股 9.00 元现金红利，已披露 2025-2027 年分红率不低于 75%、每股不低于 1.22 元的股东回报政策。\"},{\"evidence_refs\":[\"yili_fy2025_annual\",\"yili_2026h1\"],\"kind\":\"interpretation\",\"text\":\"高 ROE、低资本强度和明确分红政策是权益价值模型的正面输入，但不抵消当前利润下行的反证。\"}],\"quote_date\":null,\"research_status\":\"financial_scope_approved\",\"research_version\":\"pending-600887-2026-10-22-short-advantage-215d53e30e3f\",\"return_driver\":\"常温/低温乳品结构升级、奶粉品类份额和渠道现金转换；利润再投资或股东回报的效率。\",\"run_id\":\"pending-600887-2026-10-22-short-advantage-215d53e30e3f\",\"symbol\":\"600887\",\"thesis\":\"全国品牌、乳业规模与全渠道形成可持续经营利润，但当前利润下行要求把历史高 ROE 显著折减，并证明分红政策可覆盖下行周期。 本候选实际消费既有有限方案：盈利条件保留一年，再用三年全资本ROE衰减至权益成本；不假定永久超额回报。 本候选实际消费既有有限方案：盈利条件保留一年，再用三年全资本ROE衰减至权益成本；不假定永久超额回报。\",\"thesis_breakers\":[{\"evidence_refs\":[\"yili_2026h1\"],\"kind\":\"hypothesis\",\"text\":\"若下一报告期归母利润继续明显下降且经营现金流回落，高分红承诺需要重新评估。\"},{\"evidence_refs\":[\"yili_2026h1\"],\"kind\":\"hypothesis\",\"text\":\"若并购资产再次出现大额减值或增量 ROIC 持续缺失，全国品牌再投资论点被削弱。\"},{\"evidence_refs\":[\"yili_2026h1\"],\"kind\":\"hypothesis\",\"text\":\"若乳制品价格带、份额或核心品类毛利率持续恶化，优质复利特征不再成立。\"}],\"valuation_status\":\"CONDITIONAL_RESEARCH_PENDING_REVIEW\"}",
