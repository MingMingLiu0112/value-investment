view_current\":false,\"exit_condition_present\":false,\"full_buy_gate_passed\":false,\"has_entry\":false,\"hold_logic_present\":false,\"model_validity_status\":\"UNKNOWN\",\"sell_reason_present\":false,\"trim_reason_present\":false},\"run_id\":\"pending-600887-2026-10-22-short-advantage-215d53e30e3f\",\"schema_version\":\"advisory-decision-recommendation-v3\",\"symbol\":\"600887\",\"thesis\":\"全国品牌、乳业规模与全渠道形成可持续经营利润，但当前利润下行要求把历史高 ROE 显著折减，并证明分红政策可覆盖下行周期。 本候选实际消费既有有限方案：盈利条件保留一年，再用三年全资本ROE衰减至权益成本；不假定永久超额回报。 本候选实际消费既有有限方案：盈利条件保留一年，再用三年全资本ROE衰减至权益成本；不假定永久超额回报。\",\"thesis_breakers\":[{\"evidence_refs\":[\"yili_2026h1\"],\"kind\":\"hypothesis\",\"text\":\"若下一报告期归母利润继续明显下降且经营现金流回落，高分红承诺需要重新评估。\"},{\"evidence_refs\":[\"yili_2026h1\"],\"kind\":\"hypothesis\",\"text\":\"若并购资产再次出现大额减值或增量 ROIC 持续缺失，全国品牌再投资论点被削弱。\"},{\"evidence_refs\":[\"yili_2026h1\"],\"kind\":\"hypothesis\",\"text\":\"若乳制品价格带、份额或核心品类毛利率持续恶化，优质复利特征不再成立。\"}],\"thesis_consistency_status\":null,\"valuation_range\":{\"base\":\"10.0988183727036325528099511989682320838773505617\",\"basis\":\"valuation_result\",\"bear\":\"9.82311355753512637821227145569788295685682866355\",\"bull\":\"10.3223115883813946287380034955011848506557986876\",\"currency\":\"CNY\"}}",
