a766e76f88ba491ef4449c13163ec1d4f973b8abf2b9fe43763aa\"},{\"id\":\"forward-path-independent-review-20261008\",\"path\":\"docs/current/600519-forward-path-independent-review-20261008-v2.md\",\"sha256\":\"37e3ba270ba78b358a853d87cbf2d3fbb1921544ac9797d99ecddaa1f5084d37\"},{\"id\":\"financial-scope-independent-review-20261008\",\"path\":\"docs/current/600519-financial-scope-independent-review-20261008.md\",\"sha256\":\"17266f29a4f64292a631fb47017d72c624367f0bfcb9ae903ac98ef1e4dd9c6c\"},{\"id\":\"equity-cost-independent-review-20261008\",\"path\":\"docs/current/600519-equity-cost-independent-review-20261008.md\",\"sha256\":\"c46e84b1475af0429708c8756e49715727b8bfe3b1523800bc7cc7916c0cb214\"},{\"id\":\"pending-economic-proposal\",\"path\":\"runtime/daily-trade-assistant/20261011-s1-pending-candidate-v5/pending-candidate/valuation-proposal.json\",\"sha256\":\"8245b3ee59ba6304f243efce9ee5bb20692c064ecbcd2e2a6950046b156b4d33\"}],\"exit_conditions\":[\"盈利、普通股资本桥接或资金分配发生实质变化时，重新研究并撤销旧结果的适用性。\",\"下一可比披露若继续成本增长快于收入且无已核对的组合/成本解释，重做利润路径并撤销盈利韧性假设适用性；单期压力不自动变成卖出。\",\"若直营迁移同时伴随持续毛利恶化和市场维护费用上升，撤销渠道净获益假设；核对同口径收入、成本、销售费用及政策而非只看直营占比。\",\"若核心产品收入与毛利亦持续恶化、系列酒压力未改善，重开核心品牌优势期及增长假设；若主情景只支持新增资本低回报，不应沿用全体利润强侵蚀解释。\"],\"input_additional_blockers\":[\"仅认可历史财务与条件剩余收益范围；中性主估值、正常化盈利及金融尾部审阅未获准入\",\"本候选优势期和全资本衰减未获主模型批准\",\"原文独立解释已形成；重大性、当前模型有效性和估值批准仍未准入\",\"pending_economic_model_review\",\"pending_complete_event_materiality_review\",\"G3_估值门\",\"等待已验证收盘行情\",\"price_bridge_pending_external_data\",\"Selected finite model assumptions remain pending economic approval.\"],\"input_model_id\":\"residual_income_or_equity_value\",\"margin_of_safety\":{\"to_base\":null,\"to_bear\":null},\"model_validity\":{\"blockers\":[],\"last_material_event_check\":null,\"model_as_of\":null,\"model_id\":null,\"status\":\"UNKNOWN\",\"valid_from\":null},\"next_events\":[{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"forward-path-independent-review-20261008\"],\"kind\":\"gap\",\"text\":\"现在可继续：依既有共享模型审阅压力用途与中性前瞻路径，明确利润口径、存量/新增资本机制、优势期及敏感性，不等待未来事实，不调参制造买入。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"gap\",\"text\":\"下一可比财报/已生效政策变化：核对核心与系列酒收入、同口径毛利、直营成本和费用、预收政策及母公司分配资金；只重开受影响假设。\"}],\"portfolio_input_status\":\"BLOCKED_PRIVATE_INPUT\",\"position_guidance\":null,\"price_attractiveness_status\":\"NOT_ASSESSABLE\",\"price_bridge_status\":\"PENDING_EXTERNAL_DATA\",\"recommendation_payload_sha256\":null,\"recommendation_reasons\":[\"blockers_present\"],\"recommendation_type\":\"NO_ACTION\",\"reduce_zone\":null,\"requires_human_review\":false,\"rule_evidence\":{\"add_evidence_present\":false,\"blockers\":[\"仅认可历史财务与条件剩余收益范围；中性主估值、正常化盈利及金融尾部审阅未获准入\",\"本候选优势期和全资本衰减未获主模型批准\",\"原文独立解释已形成；重大性、当前模型有效性和估值批准仍未准入\",\"pending_economic_model_review\",\"pending_complete_event_materiality_review\",\"G3_估值门\",\"等待已验证收盘行情\",\"Selected finite model assumptions remain pending economic approval.\",\"research_case:仅认可历史财务与条件剩余收益范围；中性主估值、正常化盈利及金融尾部审阅未获准入\",\"research_case:本候选优势期和全资本衰减未获主模型批准\",\"research_case:原文独立解释已形成；重大性、当前模型有效性和估值批准仍未准入\",\"research_case:pending_economic_model_review\",\"research_case:pending_complete_event_materiality_review\",\"research_case_valuation_not_approved\",\"valuation_status_not_approved_for_research\",\"event_materiality_review_unavailable\"],\"consistency_status\":null,\"event_review_current\":false,\"exit_condition_present\":false,\"full_buy_gate_passed\":false,\"has_entry\":false,\"hold_logic_present\":false,\"model_validity_status\":\"UNKNOWN\",\"sell_reason_present\":false,\"trim_reason_present\":false},\"run_id\":\"pending-600519-2026-10-11-B_CONTINUITY_ALTERNATIVE-91daee7dc978\",\"schema_version\":\"advisory-decision-recommendation-v3\",\"symbol\":\"600519\",\"thesis\":\"茅台酒高已实现毛利、核心产品收入韧性及直营触达支持有条件的经营价值；系列酒、成本和市场费用提供相反机制。历史扣非利润和母公司现金/权益已核对。现有五年盈利路径与后五年全资本ROE衰减是压力研究，不是中性主估值；未来资本用途、优势期及分配仍需有界假设审阅。 本候选实际消费既有有限方案：核心产品、品牌和渠道支持研究存量盈利持续性；十年是待审期限，不是已识别寿命。\",\"thesis_breakers\":[{\"evidence_refs\":[\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"hypothesis\",\"text\":\"盈利、普通股资本桥接或资金分配发生实质变化时，重新研究并撤销旧结果的适用性。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"hypothesis\",\"text\":\"下一可比披露若继续成本增长快于收入且无已核对的组合/成本解释，重做利润路径并撤销盈利韧性假设适用性；单期压力不自动变成卖出。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"hypothesis\",\"text\":\"若直营迁移同时伴随持续毛利恶化和市场维护费用上升，撤销渠道净获益假设；核对同口径收入、成本、销售费用及政策而非只看直营占比。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\",\"forward-path-independent-review-20261008\"],\"kind\":\"hypothesis\",\"text\":\"若核心产品收入与毛利亦持续恶化、系列酒压力未改善，重开核心品牌优势期及增长假设；若主情景只支持新增资本低回报，不应沿用全体利润强侵蚀解释。\"}],\"thesis_consistency_status\":null,\"valuation_range\":{\"base\":\"587.882968752928712528108758068248661826586906010\",\"basis\":\"valuation_result\",\"bear\":\"437.661037051257377210009396299208543059978060171\",\"bull\":\"812.265519341743271174653700375813758776246925340\",\"currency\":\"CNY\"}}",
