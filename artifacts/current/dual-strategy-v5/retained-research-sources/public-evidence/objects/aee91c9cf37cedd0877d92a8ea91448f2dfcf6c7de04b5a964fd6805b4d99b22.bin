label\":\"prior_period_adjustment\",\"path\":\"runtime/historical-filing-index/20260909T033444358365Z/pdfs/600519-1225475868.pdf\",\"physical_page\":78,\"scope\":\"consolidated_unless_label_specifies_parent\",\"sha256\":\"0e10aa26be46b1cf3cd03f06e834c7fb98d5dd0d661b96f8fddd4af7e846a4f6\",\"source_id\":\"cninfo:1225475868\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-08-15/1225475868.PDF\",\"unit\":\"CNY\"},{\"amount_cny\":\"-6750063.57\",\"label\":\"nontaxable_income\",\"path\":\"runtime/historical-filing-index/20260909T033444358365Z/pdfs/600519-1225475868.pdf\",\"physical_page\":78,\"scope\":\"consolidated_unless_label_specifies_parent\",\"sha256\":\"0e10aa26be46b1cf3cd03f06e834c7fb98d5dd0d661b96f8fddd4af7e846a4f6\",\"source_id\":\"cninfo:1225475868\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-08-15/1225475868.PDF\",\"unit\":\"CNY\"},{\"amount_cny\":\"190047183.89\",\"label\":\"nondeductible_items\",\"path\":\"runtime/historical-filing-index/20260909T033444358365Z/pdfs/600519-1225475868.pdf\",\"physical_page\":78,\"scope\":\"consolidated_unless_label_specifies_parent\",\"sha256\":\"0e10aa26be46b1cf3cd03f06e834c7fb98d5dd0d661b96f8fddd4af7e846a4f6\",\"source_id\":\"cninfo:1225475868\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-08-15/1225475868.PDF\",\"unit\":\"CNY\"},{\"amount_cny\":\"15405088610.51\",\"label\":\"total_tax_expense\",\"path\":\"runtime/historical-filing-index/20260909T033444358365Z/pdfs/600519-1225475868.pdf\",\"physical_page\":78,\"scope\":\"consolidated_unless_label_specifies_parent\",\"sha256\":\"0e10aa26be46b1cf3cd03f06e834c7fb98d5dd0d661b96f8fddd4af7e846a4f6\",\"source_id\":\"cninfo:1225475868\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-08-15/1225475868.PDF\",\"unit\":\"CNY\"},{\"amount_cny\":\"61438419177.29\",\"label\":\"profit_before_tax\",\"path\":\"runtime/historical-filing-index/20260909T033444358365Z/pdfs/600519-1225475868.pdf\",\"physical_page\":31,\"scope\":\"consolidated_unless_label_specifies_parent\",\"sha256\":\"0e10aa26be46b1cf3cd03f06e834c7fb98d5dd0d661b96f8fddd4af7e846a4f6\",\"source_id\":\"cninfo:1225475868\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-08-15/1225475868.PDF\",\"unit\":\"CNY\"},{\"amount_cny\":\"46033330566.78\",\"label\":\"consolidated_net_profit\",\"path\":\"runtime/historical-filing-index/20260909T033444358365Z/pdfs/600519-1225475868.pdf\",\"physical_page\":31,\"scope\":\"consolidated_unless_label_specifies_parent\",\"sha256\":\"0e10aa26be46b1cf3cd03f06e834c7fb98d5dd0d661b96f8fddd4af7e846a4f6\",\"source_id\":\"cninfo:1225475868\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-08-15/1225475868.PDF\",\"unit\":\"CNY\"},{\"amount_cny\":\"1516450144.92\",\"label\":\"nci_profit\",\"path\":\"runtime/historical-filing-index/20260909T033444358365Z/pdfs/600519-1225475868.pdf\",\"physical_page\":31,\"scope\":\"consolidated_unless_label_specifies_parent\",\"sha256\":\"0e10aa26be46b1cf3cd03f06e834c7fb98d5dd0d661b96f8fddd4af7e846a4f6\",\"source_id\":\"cninfo:1225475868\",\"source_url\":\"https://static.cninfo.com.cn/finalpage/2026-08-15/1225475868.PDF\",\"unit\":\"CNY\"}],\"open_questions\":[\"item-level after-tax parent allocation and ex-nonrecurring overlap for tax/credit\",\"forward operating profit path\",\"capital-return and competitive-advantage fade assumptions\"],\"prior_h1_cross_check\":{\"annual_q1_plus_q2_ex_parent_cny\":\"45390247623.82\",\"annual_q1_plus_q2_parent_cny\":\"45402962298.10\",\"residual_cny\":\"0.00\"},\"report_period\":\"2026-06-30\",\"schema_version\":\"issuer-profit-adjustment-research-v1\",\"scope\":\"HISTORICAL_ACCOUNTING_CLASSIFICATION_NOT_FORWARD_NORMALIZATION_APPROVAL\",\"symbol\":\"600519\",\"tax_expense_bridge\":{\"already_tax_expense_item_do_not_tax_again\":true,\"components_cny\":{\"nondeductible_items\":\"190047183.89\",\"nontaxable_income\":\"-6750063.57\",\"prior_period_adjustment\":\"-137159711.51\",\"statutory_applicable_rate_expense\":\"15359604794.32\",\"subsidiary_rate_difference\":\"-653592.63\"},\"consolidated_profit_benefit_from_prior_period_adjustment_cny\":\"137159711.51\",\"expense_cny\":\"15405088610.51\",\"overlap_with_ex_nonrecurring\":\"UNKNOWN\",\"parent_allocation_cny\":null,\"printed_component_sum_cny\":\"15405088610.50\",\"printed_reconciliation_residual_cny\":\"0.01\",\"residual_classification\":\"ONE_CENT_PRINTED_DISCREPANCY_NOT_REWRITTEN_OR_PROVEN_ROUNDING\"}},\"ttm_ex_nonrecurring_parent_profit_cny\":\"81367067677.44\"},\"generated_at\":\"2026-10-11T08:21:50.762534+00:00\",\"industry\":\"食品饮料-白酒\",\"investment_path\":\"有界权益研究\",\"mispricing_hypothesis\":\"待检验的预期分歧是渠道/预收政策变化是否被混同为消费需求恶化，以及现有全资本强衰减是否夸大存量盈利侵蚀；当前没有经批准的中性估值或价格隐含预期结论，不能认定市场误定价。\",\"missing_date_reasons\":{\"quote_date\":\"New pending model has no admitted quote.\"},\"name\":\"贵州茅台\",\"next_events\":[{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"forward-path-independent-review-20261008\"],\"kind\":\"gap\",\"text\":\"现在可继续：依既有共享模型审阅压力用途与中性前瞻路径，明确利润口径、存量/新增资本机制、优势期及敏感性，不等待未来事实，不调参制造买入。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"gap\",\"text\":\"下一可比财报/已生效政策变化：核对核心与系列酒收入、同口径毛利、直营成本和费用、预收政策及母公司分配资金；只重开受影响假设。\"}],\"positives\":[{\"evidence_refs\":[\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"fact\",\"text\":\"半年报有归母权益、归母盈利和普通股分母原文；输入范围可追溯。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"interpretation\",\"text\":\"FY茅台酒占酒类收入86.80%、毛利率93.53%，核心产品收入同比+0.39%而系列酒-9.76%；支持分开评价核心产品韧性与系列酒压力，不证明永久定价权。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"interpretation\",\"text\":\"FY直营酒类收入占50.09%、分区毛利率94.58%，H1直营占当期酒类收入57.32%；存在直接触达与收益获取渠道，但期间差异不是渠道同比增速，也不证明新增消费。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"interpretation\",\"text\":\"H1营收同比+1.47%、合并毛利率89.56%，保有较高已实现盈利缓冲；该韧性须与成本增速和费用压力同时研究，不能直接外推归母利润增长。\"}],\"quote_date\":null,\"research_status\":\"financial_scope_approved\",\"research_version\":\"pending-600519-2026-10-11-B_CONTINUITY_ALTERNATIVE-91daee7dc978\",\"return_driver\":\"核心产品盈利与渠道实现、成本及市场维护费用共同决定归母利润；股东回报依赖可持续分配和留存资本用途，而非高毛利或低估值标签本身。\",\"run_id\":\"pending-600519-2026-10-11-B_CONTINUITY_ALTERNATIVE-91daee7dc978\",\"symbol\":\"600519\",\"thesis\":\"茅台酒高已实现毛利、核心产品收入韧性及直营触达支持有条件的经营价值；系列酒、成本和市场费用提供相反机制。历史扣非利润和母公司现金/权益已核对。现有五年盈利路径与后五年全资本ROE衰减是压力研究，不是中性主估值；未来资本用途、优势期及分配仍需有界假设审阅。 本候选实际消费既有有限方案：核心产品、品牌和渠道支持研究存量盈利持续性；十年是待审期限，不是已识别寿命。\",\"thesis_breakers\":[{\"evidence_refs\":[\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"hypothesis\",\"text\":\"盈利、普通股资本桥接或资金分配发生实质变化时，重新研究并撤销旧结果的适用性。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"hypothesis\",\"text\":\"下一可比披露若继续成本增长快于收入且无已核对的组合/成本解释，重做利润路径并撤销盈利韧性假设适用性；单期压力不自动变成卖出。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\"],\"kind\":\"hypothesis\",\"text\":\"若直营迁移同时伴随持续毛利恶化和市场维护费用上升，撤销渠道净获益假设；核对同口径收入、成本、销售费用及政策而非只看直营占比。\"},{\"evidence_refs\":[\"operating-mechanism-evidence-20261008\",\"operating-mechanism-research-20261008\",\"cninfo:1225114741\",\"cninfo:1225475868\",\"forward-path-independent-review-20261008\"],\"kind\":\"hypothesis\",\"text\":\"若核心产品收入与毛利亦持续恶化、系列酒压力未改善，重开核心品牌优势期及增长假设；若主情景只支持新增资本低回报，不应沿用全体利润强侵蚀解释。\"}],\"valuation_status\":\"CONDITIONAL_RESEARCH_PENDING_REVIEW\"}",
