    "positives": [
      {
        "kind": "fact",
        "text": "半年报有归母权益、归母盈利和普通股分母原文；输入范围可追溯。",
        "evidence_refs": [
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      },
      {
        "kind": "interpretation",
        "text": "FY茅台酒占酒类收入86.80%、毛利率93.53%，核心产品收入同比+0.39%而系列酒-9.76%；支持分开评价核心产品韧性与系列酒压力，不证明永久定价权。",
        "evidence_refs": [
          "operating-mechanism-evidence-20261008",
          "operating-mechanism-research-20261008",
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      },
      {
        "kind": "interpretation",
        "text": "FY直营酒类收入占50.09%、分区毛利率94.58%，H1直营占当期酒类收入57.32%；存在直接触达与收益获取渠道，但期间差异不是渠道同比增速，也不证明新增消费。",
        "evidence_refs": [
          "operating-mechanism-evidence-20261008",
          "operating-mechanism-research-20261008",
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      },
      {
        "kind": "interpretation",
        "text": "H1营收同比+1.47%、合并毛利率89.56%，保有较高已实现盈利缓冲；该韧性须与成本增速和费用压力同时研究，不能直接外推归母利润增长。",
        "evidence_refs": [
          "operating-mechanism-evidence-20261008",
          "operating-mechanism-research-20261008",
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      }
    ],
    "counter_evidence": [
      {
        "kind": "interpretation",
        "text": "现有假设诊断将路径限定为强衰减压力情景，不能代替中性主估值。",
        "evidence_refs": [
          "assumption_diagnostic"
        ]
      },
      {
        "kind": "fact",
        "text": "扣非TTM使用年报加本期半年报减上年同期；不是跨周期正常化盈利批准。",
        "evidence_refs": [
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      },
      {
        "kind": "fact",
        "text": "7月18日限定产品渠道提价在H1期末之后，前瞻盈利影响尚未量化。",
        "evidence_refs": [
          "cninfo:1225431263",
          "independent-announcement-research-20261008"
        ]
      },
      {
        "kind": "interpretation",
        "text": "财务公司存款与合并现金流不能直接视为普通股可分配现金；分配假设仍未批准。",
        "evidence_refs": [
          "cninfo:1225475863",
          "cninfo:1225475868",
          "independent-announcement-research-20261008"
        ]
      },
      {
        "kind": "interpretation",
        "text": "非经常性归母桥已对平，扣非基准不能再扣同一金融收益；信用减值本期为正利润贡献，以前期间所得税调整为净利增益，逐项税后归母及重叠仍未知。税桥打印分项与披露合计差0.01元，原数与差额均保留。",
        "evidence_refs": [
          "profit-adjustment-bridge-20261008",
          "profit-adjustment-research-20261008"
        ]
      },
      {
        "kind": "interpretation",
        "text": "H1母公司现金及等价物下降234.75亿元，期初847.31亿元、期末612.56亿元；已执行派息350.33亿元及回购28.80亿元分别核对，不把库存股注销再算现金支出。历史现金缓冲不能证明未来75%派息；两只基金未实缴合计60亿元，付款时点未知。",
        "evidence_refs": [
          "parent-distribution-capital-bridge-20261008",
          "parent-distribution-capital-research-20261008"
        ]
      },
      {
        "kind": "interpretation",
        "text": "H1成本同比+21.81%高于营收+1.47%，合并毛利率下降1.7441个百分点；FY销售费率4.2961%高于比较期3.2998%。收入韧性没有自动变成利润增长。",
        "evidence_refs": [
          "operating-mechanism-evidence-20261008",
          "operating-mechanism-research-20261008",
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      },
      {
        "kind": "interpretation",
        "text": "FY直营收入+12.96%而直营成本+31.07%，披露直营毛利率下降0.75个百分点；H1预收款下降60.31%含营销和预付款政策变化，既不能用渠道迁移证明增量需求，也不能将预收下降机械当成需求崩塌。",
        "evidence_refs": [
          "operating-mechanism-evidence-20261008",
          "operating-mechanism-research-20261008",
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      },
      {
        "kind": "interpretation",
        "text": "独立重算确认：后五年全资本ROE衰减使第五年利润再下降52.65%/65.84%/75.35%，不是仅新增资本低回报；75%分配只适用于显式十年，终端实际约74.03%/70.40%/65.60%。压力路径不能用作中性合理价。",
        "evidence_refs": [
          "forward-path-independent-review-20261008"
        ]
      },
      {
        "kind": "interpretation",
        "text": "受限准备金两表期末/期初分别差349.29万元/370.98万元，原因未识别；原值分别保留，不重复扣现金，不能据此认证精确可分配自由现金。财务范围认可只支持历史及条件研究，不批准金融尾部、未来分配或中性主估值。",
        "evidence_refs": [
          "financial-scope-independent-review-20261008"
        ]
      }
    ],
    "thesis_breakers": [
      {
        "kind": "hypothesis",
        "text": "盈利、普通股资本桥接或资金分配发生实质变化时，重新研究并撤销旧结果的适用性。",
        "evidence_refs": [
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      },
      {
        "kind": "hypothesis",
        "text": "下一可比披露若继续成本增长快于收入且无已核对的组合/成本解释，重做利润路径并撤销盈利韧性假设适用性；单期压力不自动变成卖出。",
        "evidence_refs": [
          "operating-mechanism-evidence-20261008",
          "operating-mechanism-research-20261008",
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      },
      {
        "kind": "hypothesis",
        "text": "若直营迁移同时伴随持续毛利恶化和市场维护费用上升，撤销渠道净获益假设；核对同口径收入、成本、销售费用及政策而非只看直营占比。",
        "evidence_refs": [
          "operating-mechanism-evidence-20261008",
          "operating-mechanism-research-20261008",
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      },
      {
        "kind": "hypothesis",
        "text": "若核心产品收入与毛利亦持续恶化、系列酒压力未改善，重开核心品牌优势期及增长假设；若主情景只支持新增资本低回报，不应沿用全体利润强侵蚀解释。",
        "evidence_refs": [
          "operating-mechanism-evidence-20261008",
          "operating-mechanism-research-20261008",
          "cninfo:1225114741",
          "cninfo:1225475868",
          "forward-path-independent-review-20261008"
        ]
      }
    ],
    "next_events": [
      {
        "kind": "gap",
        "text": "现在可继续：依既有共享模型审阅压力用途与中性前瞻路径，明确利润口径、存量/新增资本机制、优势期及敏感性，不等待未来事实，不调参制造买入。",
        "evidence_refs": [
          "operating-mechanism-evidence-20261008",
          "operating-mechanism-research-20261008",
          "forward-path-independent-review-20261008"
        ]
      },
      {
        "kind": "gap",
        "text": "下一可比财报/已生效政策变化：核对核心与系列酒收入、同口径毛利、直营成本和费用、预收政策及母公司分配资金；只重开受影响假设。",
        "evidence_refs": [
          "operating-mechanism-evidence-20261008",
          "operating-mechanism-research-20261008",
          "cninfo:1225114741",
          "cninfo:1225475868"
        ]
      }
    ],
    "evidence_status": "verified",
    "valuation_status": "not_ready",
    "research_status": "financial_scope_approved",
    "blockers": [
      "仅认可历史财务与条件剩余收益范围；中性主估值、正常化盈利及金融尾部审阅未获准入",
      "现有强衰减压力情景不是中性主估值",
      "原文独立解释已形成；重大性、当前模型有效性和估值批准仍未准入"
    ],
