  "research_case": {
    "symbol": "600519",
    "name": "贵州茅台",
    "as_of": "2026-10-08",
    "run_id": "600519-reviewed-financial-scope-bound-20261008",
    "generated_at": "2026-10-08T14:31:10.657078+00:00",
    "research_version": "bounded-d2-model-bound-explanations-v2",
    "industry": "食品饮料-白酒",
    "investment_path": "有界权益研究",
    "thesis": "茅台酒高已实现毛利、核心产品收入韧性及直营触达支持有条件的经营价值；系列酒、成本和市场费用提供相反机制。历史扣非利润和母公司现金/权益已核对。现有五年盈利路径与后五年全资本ROE衰减是压力研究，不是中性主估值；未来资本用途、优势期及分配仍需有界假设审阅。",
    "return_driver": "核心产品盈利与渠道实现、成本及市场维护费用共同决定归母利润；股东回报依赖可持续分配和留存资本用途，而非高毛利或低估值标签本身。",
    "mispricing_hypothesis": "待检验的预期分歧是渠道/预收政策变化是否被混同为消费需求恶化，以及现有全资本强衰减是否夸大存量盈利侵蚀；当前没有经批准的中性估值或价格隐含预期结论，不能认定市场误定价。",
