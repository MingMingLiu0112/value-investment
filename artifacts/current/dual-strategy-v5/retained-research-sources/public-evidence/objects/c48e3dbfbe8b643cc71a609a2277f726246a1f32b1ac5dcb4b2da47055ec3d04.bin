            "assessment": "历史毛利强；追加正常化未知",
            "reason": "核心酒高毛利、历史扣非TTM可核；H1成本压力和费用反证不支持高ROE机械外推"
          },
          "cash": {
            "assessment": "历史资金桥可解释；持续分配未知",
            "reason": "母公司CFO、子公司上划和现金缓冲已核；合并财务公司现金不能当母公司可分红资金"
          },
          "balance_sheet": {
            "assessment": "披露偿付结构正常；金融和存货尾部未知",
            "reason": "合并负债含吸收存款，金融资产净额与义务分开；陈酿存货不是立即可售现金"
          },
          "growth": {
            "assessment": "近期盈利增长弱；未来路径是假设",
            "reason": "年度及H1利润承压、产品与渠道分化；允许有界条件，不把高毛利视为必然恢复"
          },
          "capital_allocation": {
            "assessment": "历史执行与资本桥可核；增量回报未知",
            "reason": "已付股息、回购、注销和基金承诺分别核对；留存不自动赚历史品牌ROE"
          }
        },
