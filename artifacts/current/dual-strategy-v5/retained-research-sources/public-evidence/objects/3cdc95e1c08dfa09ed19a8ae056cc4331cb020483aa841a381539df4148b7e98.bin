    "positives": [
      {
        "kind": "fact",
        "text": "FY2025 审计报告为无保留意见，归母净利润 115.65 亿元，加权平均 ROE 20.87%。",
        "evidence_refs": [
          "yili_fy2025_annual"
        ]
      },
      {
        "kind": "fact",
        "text": "FY2025 末期每 10 股 9.00 元现金红利，已披露 2025-2027 年分红率不低于 75%、每股不低于 1.22 元的股东回报政策。",
        "evidence_refs": [
          "yili_fy2025_annual"
        ]
      },
      {
        "kind": "interpretation",
        "text": "高 ROE、低资本强度和明确分红政策是权益价值模型的正面输入，但不抵消当前利润下行的反证。",
        "evidence_refs": [
          "yili_fy2025_annual",
          "yili_2026h1"
        ]
      }
    ],
    "counter_evidence": [
      {
        "kind": "fact",
        "text": "2026H1 收入 +4.13%，归母净利润 -20.02%，扣非归母净利润 -20.25%；加权平均 ROE 10.09%。",
        "evidence_refs": [
          "yili_2026h1"
        ]
      },
      {
        "kind": "fact",
        "text": "2026H1 计提商誉减值 15.47 亿元、资产减值合计 24.56 亿元；合同负债较期初下降 53.15%。",
        "evidence_refs": [
          "yili_2026h1"
        ]
      },
      {
        "kind": "interpretation",
        "text": "利润下行与减值说明历史 ROE 不能机械外推；模型必须使用更低的预测 ROE 和显式品牌再投资风险。",
        "evidence_refs": [
          "yili_2026h1",
          "yili_fy2025_annual"
        ]
      },
      {
        "kind": "hypothesis",
        "text": "盈利下降、减值及融资约束可能使短期持续性也无法成立。",
        "evidence_refs": [
          "prior-3ec6e2c95534-pending-economic-proposal"
        ]
      }
    ],
    "thesis_breakers": [
      {
        "kind": "hypothesis",
        "text": "若下一报告期归母利润继续明显下降且经营现金流回落，高分红承诺需要重新评估。",
        "evidence_refs": [
          "yili_2026h1"
        ]
      },
      {
        "kind": "hypothesis",
        "text": "若并购资产再次出现大额减值或增量 ROIC 持续缺失，全国品牌再投资论点被削弱。",
        "evidence_refs": [
          "yili_2026h1"
        ]
      },
      {
        "kind": "hypothesis",
        "text": "若乳制品价格带、份额或核心品类毛利率持续恶化，优质复利特征不再成立。",
        "evidence_refs": [
          "yili_2026h1"
        ]
      }
    ],
    "next_events": [
      {
        "kind": "fact",
        "text": "观察下一份法定财务报告的收入、分产品毛利率、经营现金流、合同负债、应收和短期借款。",
        "evidence_refs": [
          "yili_2026h1"
        ]
      },
      {
        "kind": "gap",
        "text": "补充普通股分母、可分配现金和回购/分红执行情况后再做正式人工批准。"
      }
    ],
