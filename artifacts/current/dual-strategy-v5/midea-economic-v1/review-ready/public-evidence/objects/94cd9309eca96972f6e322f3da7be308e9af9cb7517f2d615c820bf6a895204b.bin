        "canonical_payload": "{\"action\":\"no_order\",\"blockers\":[\"DRAFT_NOT_APPROVED\",\"EVENT_MATERIALITY_PENDING_HUMAN_REVIEW\",\"EVENT_COVERAGE_INCOMPLETE\",\"STRICT_CONTEMPORANEOUS_PIT_NOT_PROVEN\",\"ECONOMIC_PARAMETERS_NOT_VALIDATED\",\"G1_财务门\",\"G3_估值门\",\"event scan coverage is incomplete\",\"EVENT_COVERAGE_INCOMPLETE: the CNINFO snapshot was captured before the research day closed.\",\"Four 2026-10-14 and 2026-10-17 announcements remain PENDING_HUMAN_REVIEW.\",\"STRICT_CONTEMPORANEOUS_PIT_NOT_PROVEN: CNINFO provided date-level times and retained files were acquired after the research cutoff.\",\"price_bridge_invalid\",\"CANDIDATE_DRAFT_ASSUMPTIONS_NOT_HUMAN_VALIDATED\",\"CANDIDATE_DRAFT_ASSUMPTION_NOT_HUMAN_VALIDATED\",\"research_case:DRAFT_NOT_APPROVED\",\"research_case:EVENT_MATERIALITY_PENDING_HUMAN_REVIEW\",\"research_case:EVENT_COVERAGE_INCOMPLETE\",\"research_case:STRICT_CONTEMPORANEOUS_PIT_NOT_PROVEN\",\"research_case:ECONOMIC_PARAMETERS_NOT_VALIDATED\",\"research_scope_not_approved\",\"research_case_valuation_not_approved\",\"valuation_status_not_approved_for_research\",\"model_validity_unknown\",\"event_materiality_review_unavailable\",\"decision_dependency_artifacts_unavailable\",\"predecision_eligibility_unavailable\",\"price assessment profile does not match valuation\",\"human_research_approval_not_resolved\"],\"confidence\":\"低\",\"counter_evidence\":[{\"evidence_refs\":[\"midea-economic-v1-accounting\",\"midea_2026h1\"],\"kind\":\"fact\",\"text\":\"H1扣非归母利润195.95179亿元，同比-25.31%；该降幅是披露事实，不等于已识别的主业盈利降幅。\"},{\"evidence_refs\":[\"midea-economic-v1-accounting\",\"midea_2026h1\"],\"kind\":\"fact\",\"text\":\"H1加权ROE11.33%，上年同期11.29%，同比+0.04个百分点；不与FY2025的19.70%直接比较或乘二年化。\"},{\"evidence_refs\":[\"midea-economic-v1-business\",\"midea_fy2025_annual\"],\"kind\":\"fact\",\"text\":\"FY2025家用/商用工业毛利率分别变动-0.08/-0.58个百分点，洗衣机销量-6.17%；收入增长并未消除竞争及产品结构压力。\"},{\"evidence_refs\":[\"midea-economic-v1-accounting\"],\"kind\":\"gap\",\"text\":\"衍生工具范围桥、OCI包含关系及项目税后归母未知，不能混合收益全额加回或构造正常化利润。\"},{\"evidence_refs\":[\"cninfo_1225608903\",\"cninfo_1225603532\",\"cninfo_1225603533\",\"cninfo_1225603534\"],\"kind\":\"gap\",\"text\":\"2026年10月14日三项公告及10月17日回购进展公告仍待逐条材料性复核，模型有效性只能保持UNKNOWN。\"}],\"current_price\":null,\"decision_as_of\":\"2026-10-22\",\"decision_dependency_refs\":[{\"artifact_id\":\"00000000-0000-0000-0000-000000000001\",\"artifact_type\":\"research_case\",\"payload_sha256\":\"dcfa18653a1995d00c572b111076575642895d99d17685ff23a71438e7b5a773\",\"role\":\"research_case\",\"scope_key\":\"000333\",\"scope_type\":\"security\"},{\"artifact_id\":\"00000000-0000-0000-0000-000000000002\",\"artifact_type\":\"financial_facts\",\"payload_sha256\":\"c51b36cedb0b95c73deda53181547a82159723a0b30a4d3bf10472ed4ddb936c\",\"role\":\"financial_facts\",\"scope_key\":\"000333\",\"scope_type\":\"security\"},{\"artifact_id\":\"00000000-0000-0000-0000-000000000003\",\"artifact_type\":\"research_gate\",\"payload_sha256\":\"6dc3b6a28d2009528b59a85ced0b12e2d1a749958d5300148f9070d28d7356ba\",\"role\":\"research_gate\",\"scope_key\":\"000333\",\"scope_type\":\"security\"},{\"artifact_id\":\"00000000-0000-0000-0000-000000000004\",\"artifact_type\":\"valuation_assumptions\",\"payload_sha256\":\"d690ec74be7b7a995bdd7c6a3ce478363b365e720cb583e3161fa97559443d84\",\"role\":\"valuation_assumptions\",\"scope_key\":\"000333\",\"scope_type\":\"security\"},{\"artifact_id\":\"00000000-0000-0000-0000-000000000005\",\"artifact_type\":\"valuation_result\",\"payload_sha256\":\"4b0252f1bdb3d06f7b73a842527610820c28fa06d5554bf21cd7288c18af2ed9\",\"role\":\"valuation\",\"scope_key\":\"000333\",\"scope_type\":\"security\"},{\"artifact_id\":\"00000000-0000-0000-0000-000000000006\",\"artifact_type\":\"model_validity\",\"payload_sha256\":\"dc1fc00c9391daaa6a227e1f938d3510153de2cb90fe63934e5a58a8f7bd03ba\",\"role\":\"model_validity\",\"scope_key\":\"000333\",\"scope_type\":\"security\"},{\"artifact_id\":\"00000000-0000-0000-0000-000000000008\",\"artifact_type\":\"price_bri