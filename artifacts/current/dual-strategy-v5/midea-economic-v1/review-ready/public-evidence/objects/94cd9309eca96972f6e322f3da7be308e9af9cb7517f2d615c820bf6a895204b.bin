    "entry_zone": null,
    "reduce_zone": null,
    "exit_conditions": [
      "若未来两年ROE持续低于9%的候选权益门槛，剩余收益假设失效。",
      "若利润下降伴随经营现金转换和资产负债表质量同步恶化，当前底部ROE路径仍需下调。",
      "若股本注销、回购或分红导致普通股分母与可分配现金桥接发生变化，必须重算每股价值。",
      "新同口径定期披露改变利润/毛利率/现金转换或资本回报判断。",
      "已披露资本、库存股、回购注销、分配或重大公告改变输入。",
      "可核验新工具范围、税后归属或OCI桥足以改变正常化解释。",
      "独立审核否定持续期、权益成本、分配或终端经济依据。"
    ],
    "thesis": "同期H1加权ROE11.33%对11.29%，不能由半年/全年误比认定恶化。扣非下降涉及汇兑与风险管理工具分类不对称，不能等同主业等幅下降。规模、渠道、全球化及ToB增长支持研究资本回报持续性，毛利率与销量反证限制外推。全部旧ROE及终端参数仅保留为低置信待审条件。",
    "counter_evidence": [
      {
        "kind": "fact",
        "text": "H1扣非归母利润195.95179亿元，同比-25.31%；该降幅是披露事实，不等于已识别的主业盈利降幅。",
        "evidence_refs": [
          "midea-economic-v1-accounting",
          "midea_2026h1"
        ]
      },
      {
        "kind": "fact",
        "text": "H1加权ROE11.33%，上年同期11.29%，同比+0.04个百分点；不与FY2025的19.70%直接比较或乘二年化。",
        "evidence_refs": [
          "midea-economic-v1-accounting",
          "midea_2026h1"
        ]
      },
      {
        "kind": "fact",
        "text": "FY2025家用/商用工业毛利率分别变动-0.08/-0.58个百分点，洗衣机销量-6.17%；收入增长并未消除竞争及产品结构压力。",
        "evidence_refs": [
          "midea-economic-v1-business",
          "midea_fy2025_annual"
        ]
      },
      {
        "kind": "gap",
        "text": "衍生工具范围桥、OCI包含关系及项目税后归母未知，不能混合收益全额加回或构造正常化利润。",
        "evidence_refs": [
          "midea-economic-v1-accounting"
        ]
      },
      {
        "kind": "gap",
        "text": "2026年10月14日三项公告及10月17日回购进展公告仍待逐条材料性复核，模型有效性只能保持UNKNOWN。",
        "evidence_refs": [
          "cninfo_1225608903",
          "cninfo_1225603532",
          "cninfo_1225603533",
          "cninfo_1225603534"
        ]
      }
    ],
    "thesis_breakers": [
