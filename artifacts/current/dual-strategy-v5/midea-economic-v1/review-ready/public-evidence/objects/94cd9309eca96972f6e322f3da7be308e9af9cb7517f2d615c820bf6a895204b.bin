  "artifact_bundle": {
    "schema_version": "research-decision-artifact-bundle-v1",
    "artifacts": [
      {
        "artifact_id": "00000000-0000-0000-0000-000000000001",
        "identity": {
          "scope_type": "security",
          "scope_key": "000333",
          "artifact_type": "research_case",
          "schema_version": "c3-v1",
          "as_of": "2026-10-22",
          "available_at": "2026-10-21T19:31:06.744906+00:00"
        },
        "canonical_payload": "{\"as_of\":\"2026-10-22\",\"blockers\":[\"DRAFT_NOT_APPROVED\",\"EVENT_MATERIALITY_PENDING_HUMAN_REVIEW\",\"EVENT_COVERAGE_INCOMPLETE\",\"STRICT_CONTEMPORANEOUS_PIT_NOT_PROVEN\",\"ECONOMIC_PARAMETERS_NOT_VALIDATED\"],\"counter_evidence\":[{\"evidence_refs\":[\"midea-economic-v1-accounting\",\"midea_2026h1\"],\"kind\":\"fact\",\"text\":\"H1扣非归母利润195.95179亿元，同比-25.31%；该降幅是披露事实，不等于已识别的主业盈利降幅。\"},{\"evidence_refs\":[\"midea-economic-v1-accounting\",\"midea_2026h1\"],\"kind\":\"fact\",\"text\":\"H1加权ROE11.33%，上年同期11.29%，同比+0.04个百分点；不与FY2025的19.70%直接比较或乘二年化。\"},{\"evidence_refs\":[\"midea-economic-v1-business\",\"midea_fy2025_annual\"],\"kind\":\"fact\",\"text\":\"FY2025家用/商用工业毛利率分别变动-0.08/-0.58个百分点，洗衣机销量-6.17%；收入增长并未消除竞争及产品结构压力。\"},{\"evidence_refs\":[\"midea-economic-v1-accounting\"],\"kind\":\"gap\",\"text\":\"衍生工具范围桥、OCI包含关系及项目税后归母未知，不能混合收益全额加回或构造正常化利润。\"},{\"evidence_refs\":[\"cninfo_1225608903\",\"cninfo_1225603532\",\"cninfo_1225603533\",\"cninfo_1225603534\"],\"kind\":\"gap\",\"text\":\"2026年10月14日三项公告及10月17日回购进展公告仍待逐条材料性复核，模型有效性只能保持UNKNOWN。\"}],\"evidence_refs\":[{\"id\":\"midea_fy2025_annual\",\"sha256\":\"16f95f70527db59dcf2736f276a9479cf7ee917e5f71e4f6cbbe83acbad9f4b6\"},{\"id\":\"midea_2026h1\",\"sha256\":\"576dd80e353e53296a800b03e9889a9cbb2e8b91fa2ab3c1dace7c10159179b8\"},{\"id\":\"midea_202606_hkex_monthly_return\",\"sha256\":\"fab9be2f0349dcda9880b178e45e4dd65474b98635bf454adeeb19ed7bc3ecfd\"},{\"id\":\"cninfo_1225608903\",\"sha256\":\"cca6dc38ff6b5353422fe36f173108931ec53c734372d2b30cfeacb6260077fd\"},{\"id\":\"cninfo_1225603532\",\"sha256\":\"6732a5255485d7cdd81d0b73af961fac639c3f344420b84c1a69ac135be7a0bd\"},{\"id\":\"cninfo_1225603533\",\"sha256\":\"e0aebb190712c15e82b29297c1e27d843564ea51cfe36f587eb0955bbe63985c\"},{\"id\":\"cninfo_1225603534\",\"sha256\":\"b38a3d71faa803d485d3400410a1dab61699653fc8635e6b2d435df86f04d733\"},{\"id\":\"midea-economic-v1-accounting\",\"path\":\"artifacts/current/dual-strategy-v5/midea-earnings-interpretation-correction.json\",\"sha256\":\"f074c7f7ecd9d7072dc5061c792284985a3abbe713de2a0d505bfac91f4a7462\"},{\"id\":\"midea-economic-v1-stress\",\"path\":\"artifacts/current/dual-strategy-v5/midea-existing-model-sensitivity.json\",\"sha256\":\"dfdbf4047fc86d0c2248cddd0394ede91f529af25f51baec59d4a8b66a78cef8\"},{\"id\":\"midea-economic-v1-business\",\"path\":\"runtime/company-research/midea-business-evidence-20260921/evidence.json\",\"sha256\":\"de60b009c83770834c033b06b71a093bacfd739be6b2bf4fa4cb1a029b6f4cc8\"},{\"id\":\"midea-economic-v1-distribution\",\"path\":\"runtime/company-research/midea-2014-2024-equity-return-candidate-20260922/evidence.json\",\"sha256\":\"6726e821972d0490753a6cc718f6f54515ccbfbb53341f081900af208eab7ea1\"},{\"id\":\"midea-economic-v1-proposal\",\"path\":\"artifacts/current/dual-strategy-v5/midea-economic-v1/economic-research.json\",\"sha256\":\"c3072cfee415fb62e2defded2b993e8aae6b095c56d944c1290d7255919fbe99\"}],\"evidence_status\":\"verified\",\"financial_period\":\"2026-06-30\",\"financial_summary\":{\"a_ordinary_shares_excluding_treasury\":\"6813498835\",\"economic_parameters_validated\":false,\"economic_research_proposal_binding\":{\"path\":\"artifacts/current/dual-strategy-v5/midea-economic-v1/economic-research.json\",\"sha256\":\"c3072cfee415fb62e2defded2b993e8aae6b095c56d944c1290d7255919fbe99\"},\"fy2025_parent_equity_cny\":\"223221305000\",\"fy2025_parent_profit_cny\":\"43945411000\",\"fy2025_weighted_roe\":\"0.1970\",\"h1_2025_weighted_roe\":\"0.1129\",\"h1_2026_adjusted_parent_profit_cny\":\"19595179000\",\"h1_2026_adjusted_parent_profit_yoy\":\"-0.2531\",\"h1_2026_parent_equity_cny\":\"212861055000\",\"h1_2026_parent_equity_thousand_cny\":\"212861055\",\"h1_2026_parent_profit_cny\":\"26446037000\",\"h1_2026_revenue_cny\":\"260042490000\",\"h1_2026_roe\":\"0.1133\",\"h1_weighted_roe_yoy_change_pp\":\"0.04\",\"h_ordinary_shares\":\"650848500\",\"historical_proposed_cash_payout_ratios\":{\"2022\":\"0.581577402\",\"2023\":\"0.615694411\",\"2024\":\"0.693139013\"},\"interpretation_scope\":\"Reported/comparative facts and bounded hypotheses; not normalized earnings, paid dividends or verified forward inputs.\",\"normalized_parent_profit_cny\":null,\"ordinary_shares_20260630\":\"7464347335\",\"period_end\":\"2026-06-30\",\"pressure_experiment_binding\":{\"path\":\"artifacts/current/dual-strategy-v5/midea-existing-model-sensitivity.json\",\"sha256\":\"dfdbf4047fc86d0c2248cddd0394ede91f529af25f51baec59d4a8b66a78cef8\"},\"reported_business_facts\":{\"air_conditioner_volume_growth_pct\":\"12.89\",\"commercial_industrial_gross_margin_change_pct_points\":\"-0.58\",\"commercial_industrial_gross_margin_pct\":\"20.81\",\"commercial_industrial_revenue_cny\":\"122752958000\",\"commercial_industrial_revenue_growth_pct\":\"17.47\",\"household_gross_margin_change_pct_points\":\"-0.08\",\"household_gross_margin_pct\":\"29.90\",\"household_revenue_cny\":\"299927239000\",\"household_revenue_growth_pct\":\"11.28\",\"operating_revenue_cny\":\"456451731000\",\"operating_revenue_growth_pct\":\"12.11\",\"refrigeration_volume_growth_pct\":\"2.62\",\"research_development_expense_cny\":\"17787624000\",\"research_development_expense_growth_pct\":\"9.58\",\"washing_appliance_volume_growth_pct\":\"-6.17\"}},\"generated_at\":\"2026-10-21T19:31:06.744906+00:00\",\"industry\":\"家用电器-白色家电\",\"investment_path\":\"成熟制造复利 / 全球化与现金回报\",\"mispricing_hypothesis\":\"本版本只收口经济研究依据与反证；不比较现价，不证明低估，不选择压力实验最优格。\",\"missing_date_reasons\":{},\"name\":\"美的集团\",\"next_events\":[{\"evidence_refs\":[\"cninfo_1225608903\",\"cninfo_1225603532\",\"cninfo_1225603533\",\"cninfo_1225603534\"],\"kind\":\"fact\",\"text\":\"人工复核临时股东会决议、法律意见、注册资本减少及最新回购进展公告。\"},{\"evidence_refs\":[\"midea_2026h1\"],\"kind\":\"gap\",\"text\":\"下一期定期报告发布后复核利润、现金转换和ROE路径。\"}],\"positives\":[{\"evidence_refs\":[\"midea_fy2025_annual\"],\"kind\":\"fact\",\"text\":\"FY2025归母净利润439.45亿元、归母权益2,232.21亿元，加权ROE 19.70%。\"},{\"evidence_refs\":[\"midea_fy2025_annual\"],\"kind\":\"fact\",\"text\":\"FY2025每10股派38.00元，披露基数7,522,863,645股。\"},{\"evidence_refs\":[\"midea_fy2025_annual\",\"midea_2026h1\"],\"kind\":\"interpretation\",\"text\":\"规模、渠道和全球化仍可能支持高于门槛的资本回报，但必须由未来盈利和现金转换验证。\"},{\"evidence_refs\":[\"midea-economic-v1-business\",\"midea_fy2025_annual\"],\"kind\":\"fact\",\"text\":\"FY2025家用收入2999.27239亿元、+11.28%；商用工业1227.52958亿元、+17.47%；研发177.87624亿元、+9.58%。\"},{\"evidence_refs\":[\"midea-economic-v1-distribution\"],\"kind\":\"interpretation\",\"text\":\"历史拟派现金分红比率约58%至69%，可支持讨论60%至70%派付条件，但不证明实际支付或未来可分配现金。\"}],\"quote_date\":\"2026-10-16\",\"research_status\":\"DRAFT_NOT_APPROVED\",\"research_version\":\"midea-economic-review-ready-20261021T193106744906Z\",\"return_driver\":\"家电主业效率、全球化收入结构、ToB业务质量、现金转换与股东回报。\",\"run_id\":\"midea-economic-review-ready-20261021T193106744906Z\",\"symbol\":\"000333\",\"thesis\":\"同期H1加权ROE11.33%对11.29%，不能由半年/全年误比认定恶化。扣非下降涉及汇兑与风险管理工具分类不对称，不能等同主业等幅下降。规模、渠道、全球化及ToB增长支持研究资本回报持续性，毛利率与销量反证限制外推。全部旧ROE及终端参数仅保留为低置信待审条件。\",\"thesis_breakers\":[{\"evidence_refs\":[\"midea_2026h1\"],\"kind\":\"hypothesis\",\"text\":\"若未来两年ROE持续低于9%的候选权益门槛，剩余收益假设失效。\"},{\"evidence_refs\":[\"midea_2026h1\"],\"kind\":\"hypothesis\",\"text\":\"若利润下降伴随经营现金转换和资产负债表质量同步恶化，当前底部ROE路径仍需下调。\"},{\"evidence_refs\":[\"midea_202606_hkex_monthly_return\",\"cninfo_1225608903\",\"cninfo_1225603532\",\"cninfo_1225603533\",\"cninfo_1225603534\"],\"kind\":\"hypothesis\",\"text\":\"若股本注销、回购或分红导致普通股分母与可分配现金桥接发生变化，必须重算每股价值。\"},{\"evidence_refs\":[\"midea-economic-v1-proposal\"],\"kind\":\"hypothesis\",\"text\":\"新同口径定期披露改变利润/毛利率/现金转换或资本回报判断。\"},{\"evidence_refs\":[\"midea-economic-v1-proposal\"],\"kind\":\"hypothesis\",\"text\":\"已披露资本、库存股、回购注销、分配或重大公告改变输入。\"},{\"evidence_refs\":[\"midea-economic-v1-proposal\"],\"kind\":\"hypothesis\",\"text\":\"可核验新工具范围、税后归属或OCI桥足以改变正常化解释。\"},{\"evidence_refs\":[\"midea-economic-v1-proposal\"],\"kind\":\"hypothesis\",\"text\":\"独立审核否定持续期、权益成本、分配或终端经济依据。\"}],\"valuation_status\":\"conditional_research_only\"}",
        "payload_sha256": "dcfa18653a1995d00c572b111076575642895d99d17685ff23a71438e7b5a773",
