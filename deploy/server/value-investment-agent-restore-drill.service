[Unit]
Description=Verify the latest value investment Agent backup in isolation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/value-investment-agent
ExecStart=/bin/bash -e -o pipefail -c 'latest=$$(find /opt/value-investment-agent/backups -name "*.manifest.json" -printf "%%T@ %%p\\n" | sort -nr | sed -n "1s/^[^ ]* //p"); test -n "$$latest"; /opt/value-investment-agent/deploy/server/run_restore_drill.sh "$$latest"'
