[Unit]
Description=Freeze the previous month for the value investment Agent
After=network-online.target value-investment-agent-update.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/value-investment-agent
EnvironmentFile=/etc/value-investment-agent/agent.env
ExecStart=/opt/value-investment-agent/deploy/server/run_monthly_snapshot.sh
