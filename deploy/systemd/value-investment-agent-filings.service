[Unit]
Description=Archive official CNINFO reports for the value investment Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/value-investment-agent
EnvironmentFile=/etc/value-investment-agent/agent.env
ExecStart=/opt/value-investment-agent/deploy/server/run_collect_filings.sh
# A transient provider or network failure retries promptly, while the collector
# itself remains memory-capped by its short-lived Podman commands.
Restart=on-failure
RestartSec=10min
