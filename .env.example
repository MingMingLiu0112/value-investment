# PostgreSQL started by docker-compose.yml
DATABASE_URL=postgresql://value_agent_reader:replace-with-reader-password@your-server.tailnet.ts.net:5432/value_agent

# Must point to a different, disposable database. Never reuse DATABASE_URL.
RESTORE_DATABASE_URL=

# Keep runtime and local backups outside cloud sync; replicate encrypted backups separately.
BACKUP_DIRECTORY=backups
WORKBOOK_PATH=C:\Users\we\WPSDrive\197617831\WPS云盘\价投跟踪\A股价值投资_Agent前端智能跟踪模板.xlsx
OUTPUT_DIRECTORY=runtime
DATA_MAX_AGE_HOURS=30
PRICE_CONFLICT_TOLERANCE=0.03
POSTGRES_CONTAINER_NAME=value-investment-postgres
RESTORE_CONTAINER_NAME=value-investment-restore-postgres
CONTAINER_RUNTIME=podman
# First-party disclosure PDFs are collected on the server and included in backups.
EVIDENCE_DIRECTORY=evidence
# Optional only for server-side public data collection when direct DNS is unavailable.
COLLECTOR_PROXY_URL=
# Container-only CNINFO addresses for the official filing collector. Update
# these only after verifying a TLS request against the official hostname.
CNINFO_WEB_IP=171.109.111.148
CNINFO_STATIC_IP=124.225.115.71
