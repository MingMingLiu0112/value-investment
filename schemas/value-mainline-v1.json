{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:value-investment:value-mainline-v1",
  "$comment": "11模块接口设计；实现覆盖以唯一能力目录为准。原生事实及外部bytes验证不可由JSON Schema代替。",
  "$ref": "#/$defs/ModuleRun",
  "$defs": {
    "ModuleRun": {
      "type": "object",
      "required": [
        "schema_version",
        "action",
        "run_id",
        "module_id",
        "run_type",
        "status",
        "parent_run_ids",
        "created_at",
        "started_at",
        "finished_at",
        "input_manifest",
        "output_manifest",
        "source_refs",
        "artifact_refs",
        "metrics",
        "model_version",
        "rule_version",
        "code_commit",
        "symbol",
        "stage_events",
        "warnings",
        "errors"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "module-run-v1"
        },
        "action": {
          "const": "no_order"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "module_id": {
          "enum": [
            "A",
            "B",
            "C",
            "D1",
            "D2",
            "E1",
            "E2",
            "F1",
            "F2",
            "G1",
            "G2"
          ]
        },
        "run_type": {
          "enum": [
            "FULL",
            "INCREMENTAL",
            "REPLAY",
            "VALIDATE"
          ]
        },
        "status": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "SUCCESS",
            "FAILED",
            "CANCELLED",
            "BLOCKED",
            "PARTIAL"
          ]
        },
        "parent_run_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "input_manifest": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "schema_id",
            "items",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "schema_id": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "role",
                  "schema_id",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "schema_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "payload": {
                    "type": "object"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hash_basis": {
                    "enum": [
                      "RAW_BYTES",
                      "CANONICAL_JSON"
                    ]
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "payload"
                    ]
                  },
                  {
                    "required": [
                      "path"
                    ]
                  },
                  {
                    "required": [
                      "artifact_id"
                    ]
                  }
                ]
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "output_manifest": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "schema_id",
            "items",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "schema_id": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "role",
                  "schema_id",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "schema_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "payload": {
                    "type": "object"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hash_basis": {
                    "enum": [
                      "RAW_BYTES",
                      "CANONICAL_JSON"
                    ]
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "payload"
                    ]
                  },
                  {
                    "required": [
                      "path"
                    ]
                  },
                  {
                    "required": [
                      "artifact_id"
                    ]
                  }
                ]
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "schema_id",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "schema_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "payload": {
                "type": "object"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "hash_basis": {
                "enum": [
                  "RAW_BYTES",
                  "CANONICAL_JSON"
                ]
              }
            },
            "oneOf": [
              {
                "required": [
                  "payload"
                ]
              },
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "artifact_id"
                ]
              }
            ]
          }
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "schema_id",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "schema_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "payload": {
                "type": "object"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "hash_basis": {
                "enum": [
                  "RAW_BYTES",
                  "CANONICAL_JSON"
                ]
              }
            },
            "oneOf": [
              {
                "required": [
                  "payload"
                ]
              },
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "artifact_id"
                ]
              }
            ]
          }
        },
        "metrics": {
          "type": "object",
          "required": [
            "assurance",
            "source_ref_validation"
          ],
          "properties": {
            "assurance": {
              "enum": [
                "TEST_ONLY",
                "REAL_PUBLIC_REPLAY",
                "REAL_PUBLIC_ACQUISITION",
                "HISTORICAL_REPLAY",
                "UNVERIFIED"
              ]
            },
            "source_ref_validation": {
              "const": "CALLER_RESPONSIBILITY"
            }
          }
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "code_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{6}$",
          "description": "null explicitly denotes batch/multi-security scope; strings are single-security codes."
        },
        "stage_events": {
          "type": "array"
        },
        "warnings": {
          "type": "array"
        },
        "errors": {
          "type": "array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "QUEUED"
              }
            }
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "null"
              },
              "finished_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "RUNNING"
              }
            }
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "string"
              },
              "finished_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "SUCCESS",
                  "PARTIAL",
                  "FAILED",
                  "CANCELLED",
                  "BLOCKED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "finished_at": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "SUCCESS",
                  "PARTIAL",
                  "FAILED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUCCESS"
              }
            }
          },
          "then": {
            "properties": {
              "errors": {
                "maxItems": 0
              },
              "output_manifest": {
                "properties": {
                  "items": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ],
      "$comment": "from_payload also enforces hashes, finite JSON, lifecycle and time order. Assurance grants no investment authority."
    },
