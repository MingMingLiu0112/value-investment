# Editor and operating-system files
.DS_Store
Thumbs.db

# WPS Cloud conflict copies. Keep them on disk for recovery, but do not track
# cloud-generated duplicates of versioned deployment definitions.
deploy/server/*-副本*.service
deploy/server/*-副本*.timer

# Local-only portable PostgreSQL environment
.m1-postgres-venv/
.m1-postgres-binary*/
