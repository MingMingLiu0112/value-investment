# Secrets and local configuration
.env
.env.*
!.env.example

# Python and test artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest-tmp*/
node_modules/

# Runtime data and backups
runtime/
backups/
*.dump
*.manifest.json
*.receipt.json
*.m3-decision-addon.xlsx
evidence-archive/
