      "external_delivery": false,
      "silence_when_no_material_change": true,
      "p0_p1_requires_human_ack": true
    },
    "resources": {
      "postgres_memory_mb": 256,
      "postgres_memory_swap_mb": 384,
      "postgres_cpu_cores": 0.5,
      "job_memory_mb": 384,
      "job_memory_plus_swap_mb": 512,
      "job_cpu_cores": 0.5,
      "minimum_available_memory_mb_before_start": 1228,
      "minimum_free_disk_mb_before_write": 2048,
      "concurrency": 1,
      "pta_priority": "absolute_stop_on_regression"
    },
    "logs": {
      "backend": "journald_plus_content_addressed_receipts",
      "retention_days": 30,
      "maximum_local_mb": 200,
      "secrets_redacted": true
    },
    "backup": {
      "schedule": "after_each_weekday_update",
      "algorithm": "AES-256-GCM",
      "local_root": "/opt/value-investment-agent/backups",
      "key_separate_from_backup": true,
      "offsite": "Alibaba_OSS_private_versioned_object_locked_bucket",
      "rpo_hours": 24,
      "rto_hours": 4,
      "restore_target": "127.0.0.1:5433/value_agent_restore"
    },
    "shadow": {
      "venues": ["SSE", "SZSE"],
      "minimum_consecutive_real_sessions": 20,
      "minimum_real_financial_or_capital_event": 1,
      "receipt_root": "/var/lib/value-investment-agent/m6/receipts",
      "witness": "distinct_Ed25519_key",
      "intake": "Alibaba_OSS_object_lock_server_timestamp_and_monotonic_chain",
      "candidate_signers": 4,
      "admission_signer": "fifth_distinct_Ed25519_key",
      "event_observation": "source_to_M5_to_session_lineage_plus_separately_pinned_event_admission",
      "historical_replay_counts": false,
      "synthetic_session_counts": false
    },
    "start_criteria": [
      "fresh_read_only_PTA_resource_baseline_passes",
      "free_disk_exceeds_reserve_plus_estimated_write",
      "production_authorization_receipt_exactly_matches_artifacts",
      "real_isolated_restore_passes_RPO_RTO",
      "official_calendar_scope_is_current",
      "all_five_signer_keys_are_distinct_and_externally_pinned"
