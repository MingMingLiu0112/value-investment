      "reader_role": "value_agent_reader",
      "remote_access": "Tailscale_private_network_only",
      "public_5432": false,
      "tls_or_tunnel_required": true
    },
    "scheduler": {
      "engine": "systemd_timer",
      "timezone": "Asia/Shanghai",
      "daily_update": "Mon..Fri 16:10",
      "market_screen": "Mon..Fri 16:30",
      "filing_scan": "every_2_hours_at_minute_20",
      "monthly_snapshot": "day_1_00:20",
      "monthly_restore_drill": "day_2_01:20",
      "single_instance_lock_required": true
