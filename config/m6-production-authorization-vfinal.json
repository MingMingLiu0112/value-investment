{
  "schema_version": "m6-production-authorization-vfinal-v1",
  "status": "READY_FOR_USER_REVIEW_NOT_AUTHORIZED",
  "action": "no_order",
  "machine_prepared": {
    "deployment_host": "47.100.97.88",
    "install_operator": "root_via_existing_ssh_only_during_authorized_window",
    "runtime_account": "root_scoped_systemd_and_rootful_podman_existing_baseline",
    "application_root": "/opt/value-investment-agent",
    "configuration_root": "/etc/value-investment-agent",
    "private_data_root": "/var/lib/value-investment-agent/private",
    "key_root": "/etc/value-investment-agent/keys",
    "database": {
      "container": "value-investment-postgres",
      "engine": "PostgreSQL 16",
      "database": "value_agent",
      "bind": "127.0.0.1:5432",
