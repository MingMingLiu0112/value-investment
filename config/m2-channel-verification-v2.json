    "cyclical": {
      "policy_version": "cyclical-verification-v2-20260924",
      "profile_constraint": "current low PE cannot imply cheap without mid-cycle normalized evidence",
      "minimum_complete_fiscal_years": 3,
      "required_checks": [
        {
          "id": "cyclical_current_margin",
          "label": "多财年当前利润率",
          "description": "当前利润率的周期位置需要多财年证据。",
