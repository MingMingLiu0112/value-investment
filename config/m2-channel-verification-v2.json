      "normalization_requirements": ["normalized_dividend_per_share"],
      "blocking_negative_fields": ["free_cash_flow", "operating_cash_flow"],
      "blocking_counter_keywords": ["特别股息", "一次性现金", "股息不可持续"],
      "evidence_freshness_days": 540
