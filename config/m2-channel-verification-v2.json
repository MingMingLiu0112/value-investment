          "label": "多财年资产负债表质量",
          "description": "负债率及有息负债或总负债需要覆盖至少三个完整财年。",
          "minimum_periods": 3,
          "required_fields": ["debt_ratio"],
          "any_of_fields": ["interest_bearing_debt", "total_liabilities"]
        }
      ],
      "normalization_requirements": [],
      "blocking_negative_fields": ["free_cash_flow", "operating_cash_flow", "net_income"],
