      "required_checks": [
        {
          "id": "quality_profitability_history",
          "label": "多财年 ROE",
          "description": "至少三个完整财年的可追溯 ROE，单期高 ROE 不得通过。",
          "minimum_periods": 3,
          "required_fields": ["roe"]
        },
        {
          "id": "quality_capital_return_history",
          "label": "多财年 ROIC 或适用替代",
          "description": "至少三个完整财年的资本回报证据。",
          "minimum_periods": 3,
          "any_of_fields": ["roic"]
        },
        {
          "id": "quality_cash_conversion",
          "label": "多财年经营现金转换",
          "description": "经营现金流及现金转换率需要覆盖至少三个完整财年。",
          "minimum_periods": 3,
          "required_fields": ["operating_cash_flow", "operating_cash_flow_to_net_income"]
