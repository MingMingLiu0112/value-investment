          "required_fields": ["operating_cash_flow_to_net_income"],
          "required_metrics": ["declared_yield"]
        },
        {
          "id": "dividend_balance_sheet",
          "label": "派息能力与负债资本强度",
          "description": "负债率与有息负债需要覆盖至少三个完整财年。",
