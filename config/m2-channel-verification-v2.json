        {
          "id": "value_normalized_earnings",
          "label": "多财年正常化收益",
          "description": "正常化收益历史不得缺失或猜测。",
          "minimum_periods": 3,
          "required_fields": ["normalized_earnings"]
        },
        {
          "id": "value_balance_sheet",
          "label": "资产负债表质量",
          "description": "负债率及有息负债或总负债需要覆盖至少三个完整财年。",
          "minimum_periods": 3,
          "required_fields": ["debt_ratio"],
