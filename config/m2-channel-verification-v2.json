        {
          "id": "dividend_fcf_coverage",
          "label": "自由现金流覆盖",
          "description": "至少三个完整财年的自由现金流覆盖派息。",
          "minimum_periods": 3,
          "required_fields": ["free_cash_flow"]
        },
        {
          "id": "dividend_payout_and_yield",
          "label": "派息率与当前收益率",
          "description": "现金转换率和当前宣告收益率必须可核验。",
