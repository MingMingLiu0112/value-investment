      "profile_constraint": "general non-financial value profile; financial institutions require a dedicated profile",
      "minimum_complete_fiscal_years": 3,
      "required_checks": [
        {
          "id": "value_cash_earnings",
          "label": "多财年现金收益",
          "description": "净利润和经营现金流需要覆盖至少三个完整财年。",
